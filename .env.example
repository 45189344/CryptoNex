# ========================================================
# CRYPTO-NEX: Blockchain Intelligence Configuration
# ========================================================

# Server
PORT=5000
NODE_ENV=development

# Optional Real Blockchain Providers (If blank, high-fidelity synthetic demo mode is active)
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=

# Analytics Microservice (Python FastAPI)
ANALYTICS_SERVICE_URL=http://localhost:8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cryptonex
POSTGRES_PASSWORD=cryptonex_secret
POSTGRES_DB=cryptonex_db
ENABLE_POSTGRES=false

# Neo4j Graph DB
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cryptonex_graph
ENABLE_NEO4J=false

# Demo & Compliance
DEMO_MODE=true
